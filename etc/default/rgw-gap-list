# usage: rgw-gap-list.py [-h] [-a MAXAGE] [-b BUCKETLIST] [-e EXCLUDELIST]
#                        [-f EXCLUDEFILE] [-c CONF]
#                        [--ceph_client_name CEPH_CLIENT_NAME]
#                        [--ceph_client_keyring CEPH_CLIENT_KEYRING] [-d] [-g]
#                        [-i INFLIGHT] [-l LISTFILE] [-m MATCH] [-n]
#                        [--namespace NAMESPACE] [-p POOL] [--promexport]
#                        [-s SYNCPOOL] [-r] [-j] [-v] [-x]
# 
# Multi-run / Multi-host capable rgw-gap-list tool
# 
# options:
#   -h, --help            show this help message and exit
#   -a, --maxage MAXAGE   Maximum age (in seconds) of last scan before rescan
#                         is forced. Default 7 days.
#   -b, --bucketlist BUCKETLIST
#                         Optional: Bucket(s) to operate on, default is all
#                         buckets, quoted space separated list is supported.
#                         Supercedes -l.
#   -e, --excludelist EXCLUDELIST
#                         Optional: Bucket(s) to skip, default is process all
#                         buckets, quoted space separated list is supported.
#                         Supercedes -f.
#   -f, --excludefile EXCLUDEFILE
#                         Optional: File with list of bucket(s) to skip,
#                         should be one bucket name per line.
#   -c, --conf CONF       Ceph conf file to use, default '/etc/ceph/ceph.conf'
#   --ceph_client_name CEPH_CLIENT_NAME
#                         Ceph client name to use, default 'client.admin'
#   --ceph_client_keyring CEPH_CLIENT_KEYRING
#                         Ceph client keyring to use, default
#                         '/etc/ceph/ceph.client.admin.keyring'
#   -d, --delete          Remove all sync objects and Exit. Used to clear all
#                         syncronized bucket status data.
#   -g, --gaps            Dump the gap results from RADOS object contents. All
#                         other options are ignore ( except -j )
#   -i, --inflight INFLIGHT
#                         Maximum number of in-flight ops to allow without a
#                         response. Default: 15000
#   -l, --listfile LISTFILE
#                         Optional: Bucket list file, should be one bucket
#                         name per line.
#   -m, --match MATCH     Specify a prefix match for the object names. Only
#                         objects matching this prefix will be checked for
#                         gaps.
#   -n, --norandom        By default, the script randomizes the list of
#                         buckets before processing. On large bucket count
#                         environments, this may cause significant delay
#                         before start of processing due to the way the
#                         randomizing occurs. Set '-n' to Not Randomize the
#                         list to remove this delay.
#   --namespace NAMESPACE
#                         What namespace to use for sync / results objects.
#                         Default: rgw-gap-list
#   -p, --pool POOL       Bucket Data Pool(s), default
#                         'default.rgw.buckets.data default.rgw.buckets.non-
#                         ec', quoted space separated list is supported.
#   --promexport          Prometheus Export. All other processing and output
#                         options are ignored if this flag is specified.
#   -s, --syncpool SYNCPOOL
#                         Synchronization / Queuing pool for the script to
#                         use, default 'default.rgw.buckets.index'.
#   -r, --report          Generate bucket scrub metadata report.
#   -j, --json            Use JSON format for bucket scrub metadata report.
#                         Only considered with -g, -r and -x
#   -v, --verbosity       Optional: Verbosity level, multiple -v's are
#                         supported for higher verbosity, example: -vvv
#   -x, --verify          Used to verify the results from a prior run.
# 
#

